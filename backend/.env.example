# ============================================================
# О.Л.Е.Г. — Конфигурация бэкенда
# Скопируйте этот файл в backend/.env и укажите свои параметры
# ============================================================

# 1. Нейросеть (LLM)
# API-ключ: OpenRouter (https://openrouter.ai/keys) или Google Gemini API (https://aistudio.google.com)
OPENROUTER_API_KEY=your_api_key_here

# Модель нейросети:
# Для OpenRouter: openai/gpt-4o-mini, google/gemini-2.5-flash, etc.
# Для прямого Google AI Studio API: gemini-2.5-flash
OPENROUTER_MODEL=gemini-2.5-flash

# Base URL:
# Для OpenRouter: https://openrouter.ai/api/v1
# Для Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Максимальное количество токенов в ответе
OPENROUTER_MAX_TOKENS=1024

# 2. Высокоскоростное голосовое распознавание (STT)
# Ключ Groq (Whisper Large v3 Turbo, ~150мс отклик, бесплатно на https://console.groq.com/keys)
GROQ_API_KEY=

# 3. Синтез речи (TTS) — Microsoft Edge-TTS
TTS_ENABLED=true
# Доступные голоса: ru-RU-DmitryNeural (мужской), ru-RU-SvetlanaNeural (женский)
TTS_VOICE=ru-RU-DmitryNeural
# Темп речи (+8% живой и бодрый, +12% быстрый, +0% спокойный)
TTS_RATE=+8%
# Высота тона
TTS_PITCH=-1Hz

# 4. Системный прокси (опционально, если API заблокирован провайдером)
# Примеры: http://127.0.0.1:8080 или socks5://127.0.0.1:1080
OLEG_PROXY=

# 5. Город по умолчанию для погоды
DEFAULT_CITY=Москва

# 6. Управление музыкой Spotify (опционально)
# Создайте приложение в https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=https://example.com/callback

# 7. Throne VPN API (опционально)
THRONE_KEY=
THRONE_ADDR=127.0.0.1:9095
